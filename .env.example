# Browser requests and OAuth must originate from this exact production origin.
SITE_ORIGIN=https://portal.example.com
# VERCEL_ENV and VERCEL_URL are trusted system values supplied by Vercel.
# Do not create or override them manually. Preview accepts only its exact VERCEL_URL origin.

# Supabase publishable values are safe in browser code only when RLS is enabled.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only rotatable secret key. Never expose it through VITE_*, browser code, logs, or dist/.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only secrets. Configure these as Sensitive values in Vercel.
GEMINI_API_KEY=replace_with_a_rotated_key
OPENWEATHER_API_KEY=replace_with_a_rotated_key
GAS_ORDER_URL=https://script.google.com/macros/s/replace_me/exec
GAS_ORDER_TOKEN=replace_with_at_least_32_random_characters

# Fixed weather location. The defaults are Takasaki when omitted.
WEATHER_LAT=36.3219
WEATHER_LON=139.0033

# Fixed company identity used to compose order emails server-side.
ORDER_COMPANY_NAME=Example Company
ORDER_DEPARTMENT_NAME=Production Management
ORDER_CONTACT_NAME=Portal Operator
ORDER_REPLY_TO=orders@example.com
